{
  "name": "root",
  "private": true,
  "engines": {
    "node": ">=20.15.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/luxon": "^1.25.0",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "@typescript-eslint/parser": "^5.39.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-depend": "^0.12.0",
    "eslint-plugin-jest": "^26.1.5",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "execa": "^5.0.0",
    "jest": "^28.1.0",
    "knip": "^5.50.2",
    "lodash": "^4.17.15",
    "luxon": "^1.25.0",
    "prettier": "^2.0.4",
    "rimraf": "^2.6.2",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build:clean": "tsc --build --clean",
    "typecheck": "tsc --build packages/* --noEmit",
    "build:extension": "yarn workspace dendron run vscode:prepublish",
    "build:views": "yarn build:clean && yarn workspace @dendronhq/dendron-plugin-views run build",
    "build": "yarn build:clean &&  yarn build:views && yarn build:extension",
    "publish": "yarn workspace dendron run vsce package --no-dependencies",
    "knip": "knip"
  },
  "dependencies": {
    "@babel/preset-typescript": "7.16.7",
    "cross-env": "^7.0.3",
    "execa": "^5.0.0",
    "jest-serializer-path": "^0.1.15"
  },
  "resolutions": {
    "trim": "0.0.3",
    "d3-color": "3.1.0"
  },
  "overrides": {
    "trim": "0.0.3",
    "d3-color": "3.1.0"
  },
  "packageManager": "yarn@4.7.0"
}
