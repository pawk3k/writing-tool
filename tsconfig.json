{
  "compilerOptions": {
    "target": "ESNext",

    "lib": ["es2019", "es2020.string"],
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "types": ["node", "vitest/globals"],
    // --- checks
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // --- language features
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "baseUrl": ".",
    "strict": true,
    "jsx": "react",
    "noImplicitAny": true,
    "paths": {
      "@dendronhq/api-server": ["packages/api-server/src"],
      "@dendronhq/common-all": ["packages/common-all/src"],
      "@dendronhq/unified": ["packages/unified/src"],
      "@dendronhq/common-server": ["packages/common-server/src"],
      "@dendronhq/common-test-utils": ["packages/common-test-utils/src"],
      "@dendronhq/engine-test-utils": ["packages/engine-test-utils/src"],
      "@dendronhq/dendron-cli": ["packages/dendron-cli/src"],
      "@dendronhq/engine-server": ["packages/engine-server/src"],
      "@dendronhq/plugin-core": ["packages/plugin-core/src"],
      "@dendronhq/pods-core": ["packages/pods-core/src"]
    }
  },
  "references": [
    { "path": "packages/common-all" },
    { "path": "packages/common-server" },
    { "path": "packages/dendron-viz" },
    { "path": "packages/engine-server" },
    { "path": "packages/api-server" },
    { "path": "packages/pods-core" },
    { "path": "packages/dendron-cli" },
    { "path": "packages/common-frontend" },
    { "path": "packages/dendron-plugin-views" },
    { "path": "packages/unified" },
    { "path": "packages/plugin-core" }
  ]
}
